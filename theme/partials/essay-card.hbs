<a class="essay-card" href="{{url}}">
    <span class="essay-card__meta">{{primary_author.name}} · {{date format="D MMM YYYY"}}</span>
    <h2 class="essay-card__title">{{title}}</h2>
    <p class="essay-card__excerpt">{{excerpt words="32"}}</p>
    <span class="essay-card__read">{{reading_time}}</span>
</a>
