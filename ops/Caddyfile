example.com {
	# Read-only allowlist: the reader needs nothing else, so login and write endpoints stay unreachable.
	@wf {
		method GET HEAD
		path /wf/nodeinfo /wf/collections/*
	}
	handle @wf {
		uri strip_prefix /wf
		rewrite * /api{path}
		reverse_proxy https://write.example.com {
			header_up Host write.example.com
		}
	}
	handle {
		root * /srv/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
write.example.com {
	reverse_proxy 127.0.0.1:8080
}
