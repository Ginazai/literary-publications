# Aliases of every WriteFreely blog to show, comma-separated. WriteFreely cannot list them for us.
# The catalog shows each blog's title and format (Blog, Novel, Notebook) from WriteFreely.
VITE_WF_ALIASES=ginazai,test,space-2
VITE_WF_DEV_TARGET=http://localhost:8080
# Production only: full URL of the WriteFreely API (defaults to the /wf proxy)
# VITE_WF_BASE=https://your-writefreely.onrender.com/api
