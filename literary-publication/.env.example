# Reference for every variable this project uses. Keep real values out of git.
# Render does NOT read this file: enter values in the Render dashboard (the Blueprint prompts for the
# ones marked "sync: false") or pass them with `docker run --env-file` when testing Ghost locally.

########## DATABASE: Aiven for MySQL (Aiven console > your service > Overview) ##########
database__connection__host=mysql-xxxx-yourproject.aivencloud.com
database__connection__port=12345                 # shown in the console; not 3306
database__connection__password=your-aiven-password
# Paste the CA certificate (Overview > CA certificate) as one value, BEGIN/END lines included:
database__connection__ssl__ca="-----BEGIN CERTIFICATE-----
...
-----END CERTIFICATE-----"

########## SITE + MAIL: you fill these in ##########
# Public site URL. Must match exactly (https://, no trailing path) or you get redirect loops.
url=https://yourdomain.com
# "From" address on all emails; must belong to your verified Mailgun domain.
mail__from="Your Publication <hello@mg.yourdomain.com>"
# Mailgun SMTP credential (staff login codes, member magic links)
mail__options__auth__user=postmaster@mg.yourdomain.com
mail__options__auth__pass=your-mailgun-smtp-password
# Mailgun API (bulk newsletters)
bulkEmail__mailgun__domain=mg.yourdomain.com
bulkEmail__mailgun__apiKey=your-mailgun-api-key

########## SET IN render.yaml: change only if you know why ##########
database__client=mysql
database__connection__database=defaultdb
database__connection__user=avnadmin
database__connection__ssl__rejectUnauthorized=true
server__host=0.0.0.0
server__port=10000
# Mailgun US region shown. EU: smtp.eu.mailgun.org and https://api.eu.mailgun.net/v3
mail__transport=SMTP
mail__options__host=smtp.mailgun.org
mail__options__port=587
bulkEmail__mailgun__baseUrl=https://api.mailgun.net/v3

########## OPTIONAL ##########
# Temporary only: skip the emailed new-device code while Mailgun is not working yet. Remove once mail works.
# security__staffDeviceVerification=false

########## GITHUB ACTIONS SECRETS (repo Settings > Secrets), for .github/workflows/deploy-theme.yml ##########
# Create via Ghost Admin > Settings > Integrations > Add custom integration.
# GHOST_ADMIN_API_URL=https://yourdomain.com
# GHOST_ADMIN_API_KEY=id:secret
